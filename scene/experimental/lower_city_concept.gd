extends Node2D
## EXPERIMENTO VISUAL — Cidade Baixa (29/10/2026).
## Isolated preview scene. Nothing in the game loads it; open it in the editor and
## press F6 (Run Current Scene). Art is original and generated by
## tools/experimental/lower_city_concept.py. Gameplay numbers mirror BiomeGenerator
## (FLOOR_TOP 420, floor 60 px, one-way platform, guard-rail bulkheads).

const DIR := "res://assets/experimental/lower_city_concept/"
const FLOOR_TOP := 420.0
const FLOOR_HEIGHT := 60.0
const WORLD_W := 1920.0
const VIEW_CENTER_Y := 384.0
const PLATFORM := Rect2(760.0, 300.0, 300.0, 14.0)
const BULKHEAD_WIDTH := 18.0

@export var auto_pan := true
@export var pan_speed := 70.0
@export var show_reference_actors := true

var _camera: Camera2D
var _pan_direction := 1.0
var _signs: Sprite2D
var _sign_glow: Sprite2D
var _puddles: Sprite2D
var _lamp: Sprite2D
var _clock := 0.0
var _flicker_at := 4.0
var _flicker_left := 0.0
var _add_material: CanvasItemMaterial


func _ready() -> void:
	texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	RenderingServer.set_default_clear_color(Color(0.016, 0.024, 0.04))
	_add_material = CanvasItemMaterial.new()
	_add_material.blend_mode = CanvasItemMaterial.BLEND_MODE_ADD
	_build_sky()
	# Depth planes, back to front. Scroll scale = how much each plane follows the camera.
	_parallax("Far", ["far"], Vector2(0.15, 0.10), Vector2(0.0, -60.0))
	var fog_far := _parallax("FogFar", ["fog"], Vector2(0.30, 0.20), Vector2(0.0, 250.0))
	fog_far.autoscroll = Vector2(-6.0, 0.0)
	var mid := _parallax("Mid", ["mid", "mid_glow", "mid_signs"], Vector2(0.45, 0.30), Vector2(0.0, -200.0))
	_sign_glow = mid.get_child(1) as Sprite2D
	_signs = mid.get_child(2) as Sprite2D
	_parallax("Rail", ["rail"], Vector2(0.70, 0.60), Vector2(0.0, -40.0))
	var fog_near := _parallax("FogNear", ["fog"], Vector2(0.80, 0.80), Vector2(320.0, 330.0))
	fog_near.autoscroll = Vector2(10.0, 0.0)
	fog_near.modulate.a = 0.8
	_build_world()
	_build_geometry()
	_build_weather()
	if show_reference_actors:
		_build_reference_actors()
	_build_camera()
	_build_label()


func _process(delta: float) -> void:
	_clock += delta
	_update_camera(delta)
	_update_lights(delta)


func _unhandled_input(event: InputEvent) -> void:
	if event.is_action_pressed("ui_accept"):
		auto_pan = not auto_pan


func _build_sky() -> void:
	var layer := CanvasLayer.new()
	layer.name = "Sky"
	layer.layer = -20
	add_child(layer)
	var sky := TextureRect.new()
	sky.texture = load(DIR + "sky.png") as Texture2D
	sky.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	sky.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	sky.stretch_mode = TextureRect.STRETCH_SCALE
	sky.mouse_filter = Control.MOUSE_FILTER_IGNORE
	sky.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	layer.add_child(sky)


func _parallax(node_name: String, textures: Array, scroll: Vector2, offset: Vector2) -> Parallax2D:
	var layer := Parallax2D.new()
	layer.name = node_name
	layer.scroll_scale = scroll
	add_child(layer)
	var width := 0.0
	for index in textures.size():
		var sprite := Sprite2D.new()
		sprite.texture = load(DIR + String(textures[index]) + ".png") as Texture2D
		sprite.centered = false
		sprite.position = offset
		# Signs and their halo are light sources: additive, no extra draw passes.
		if String(textures[index]) in ["mid_glow", "mid_signs"]:
			sprite.material = _add_material
		layer.add_child(sprite)
		width = maxf(width, float(sprite.texture.get_width()))
	layer.repeat_size = Vector2(width, 0.0)
	layer.repeat_times = 3
	return layer


func _build_world() -> void:
	var world := Sprite2D.new()
	world.name = "WorldSkin"
	world.texture = load(DIR + "world.png") as Texture2D
	world.centered = false
	world.position = Vector2(0.0, -200.0)
	world.z_index = -1
	add_child(world)
	var lights := Sprite2D.new()
	lights.name = "WorldLights"
	lights.texture = load(DIR + "world_lights.png") as Texture2D
	lights.centered = false
	lights.position = world.position
	lights.material = _add_material
	lights.z_index = -1
	add_child(lights)
	_lamp = Sprite2D.new()
	_lamp.name = "LampCone"
	_lamp.texture = load(DIR + "lamp_cone.png") as Texture2D
	_lamp.centered = false
	_lamp.position = Vector2(628.0 - _lamp.texture.get_width() * 0.5, FLOOR_TOP - _lamp.texture.get_height() + 4.0)
	_lamp.material = _add_material
	_lamp.z_index = -1
	add_child(_lamp)
	_puddles = Sprite2D.new()
	_puddles.name = "Puddles"
	_puddles.texture = load(DIR + "puddles.png") as Texture2D
	_puddles.centered = false
	_puddles.position = Vector2(0.0, FLOOR_TOP + 2.0)
	_puddles.material = _add_material
	add_child(_puddles)
	var steam := CPUParticles2D.new()
	steam.name = "StallSteam"
	steam.texture = load(DIR + "steam.png") as Texture2D
	steam.position = Vector2(250.0, FLOOR_TOP - 50.0)
	steam.amount = 14
	steam.lifetime = 2.4
	steam.emission_shape = CPUParticles2D.EMISSION_SHAPE_RECTANGLE
	steam.emission_rect_extents = Vector2(80.0, 2.0)
	steam.direction = Vector2(0.15, -1.0)
	steam.spread = 12.0
	steam.gravity = Vector2(4.0, -6.0)
	steam.initial_velocity_min = 8.0
	steam.initial_velocity_max = 16.0
	var fade := Gradient.new()
	fade.set_color(0, Color(1.0, 1.0, 1.0, 0.45))
	fade.set_color(1, Color(1.0, 1.0, 1.0, 0.0))
	steam.color_ramp = fade
	steam.z_index = -1
	add_child(steam)


func _build_geometry() -> void:
	# Physics identical in spirit to the generator; skins are drawn in world.png.
	_static_rect("Floor", Rect2(0.0, FLOOR_TOP, WORLD_W, FLOOR_HEIGHT), false)
	_static_rect("Catwalk", PLATFORM, true)
	_bulkhead(Vector2(-BULKHEAD_WIDTH * 0.5, FLOOR_TOP * 0.5), true)
	_bulkhead(Vector2(WORLD_W + BULKHEAD_WIDTH * 0.5, FLOOR_TOP * 0.5), false)


func _static_rect(node_name: String, rect: Rect2, one_way: bool) -> void:
	var body := StaticBody2D.new()
	body.name = node_name
	body.position = rect.get_center()
	var shape := CollisionShape2D.new()
	var box := RectangleShape2D.new()
	box.size = rect.size
	shape.shape = box
	shape.one_way_collision = one_way
	body.add_child(shape)
	add_child(body)


func _bulkhead(center: Vector2, left_edge: bool) -> void:
	var body := StaticBody2D.new()
	body.name = "BulkheadLeft" if left_edge else "BulkheadRight"
	body.position = center
	var shape := CollisionShape2D.new()
	var box := RectangleShape2D.new()
	box.size = Vector2(BULKHEAD_WIDTH, FLOOR_TOP)
	shape.shape = box
	body.add_child(shape)
	var half := box.size * 0.5
	var panel := Polygon2D.new()
	panel.polygon = PackedVector2Array([Vector2(-half.x, -half.y), Vector2(half.x, -half.y), half, Vector2(-half.x, half.y)])
	panel.color = Color(0.06, 0.13, 0.17)
	body.add_child(panel)
	var edge_x := half.x - 3.0 if left_edge else -half.x
	var edge := Polygon2D.new()
	edge.polygon = PackedVector2Array([Vector2(edge_x, -half.y), Vector2(edge_x + 3.0, -half.y), Vector2(edge_x + 3.0, half.y), Vector2(edge_x, half.y)])
	edge.color = Color(0.48, 0.77, 0.81)
	body.add_child(edge)
	add_child(body)


func _build_weather() -> void:
	# Rain lives on the camera so it always covers the view; two depths.
	var drop := load(DIR + "rain_drop.png") as Texture2D
	_camera = Camera2D.new()
	for config: Array in [[180, 520.0, 0.30, 0.9], [90, 780.0, 0.55, 1.0]]:
		var rain := CPUParticles2D.new()
		rain.texture = drop
		rain.amount = int(config[0])
		rain.lifetime = 1.6
		rain.preprocess = 1.6
		rain.position = Vector2(0.0, -420.0)
		rain.emission_shape = CPUParticles2D.EMISSION_SHAPE_RECTANGLE
		rain.emission_rect_extents = Vector2(760.0, 4.0)
		rain.direction = Vector2(-0.18, 1.0)
		rain.spread = 2.0
		rain.gravity = Vector2.ZERO
		rain.initial_velocity_min = float(config[1])
		rain.initial_velocity_max = float(config[1]) * 1.15
		rain.particle_flag_align_y = true
		rain.scale_amount_min = float(config[3])
		rain.scale_amount_max = float(config[3])
		rain.color = Color(1.0, 1.0, 1.0, float(config[2]))
		_camera.add_child(rain)


func _build_reference_actors() -> void:
	# Official sprites at real scale, only to judge readability. No gameplay logic.
	var jhon := Sprite2D.new()
	jhon.name = "Reference_Jhon"
	jhon.texture = load("res://assets/players/jhon/jhon_v2_idle_v2.png") as Texture2D
	jhon.hframes = 4
	jhon.position = Vector2(820.0, FLOOR_TOP - 36.0)
	add_child(jhon)
	jhon.set_meta("animated", true)
	for spot: Vector2 in [Vector2(1220.0, FLOOR_TOP), Vector2(910.0, PLATFORM.position.y)]:
		var enemy := Sprite2D.new()
		enemy.name = "Reference_Enemy"
		enemy.texture = load("res://assets/enemies/common/v2/common_idle_v2.png") as Texture2D
		enemy.hframes = 4
		enemy.scale = Vector2(0.8, 0.8)
		enemy.flip_h = true
		enemy.position = spot - Vector2(0.0, 128.0 * 0.8 * 0.5)
		enemy.set_meta("animated", true)
		add_child(enemy)


func _build_camera() -> void:
	_camera.name = "PreviewCamera"
	_camera.position = Vector2(640.0, VIEW_CENTER_Y)
	_camera.limit_left = 0
	_camera.limit_right = int(WORLD_W)
	add_child(_camera)
	_camera.make_current()


func _build_label() -> void:
	var layer := CanvasLayer.new()
	layer.layer = 100
	add_child(layer)
	var label := Label.new()
	label.text = "EXPERIMENTO VISUAL // CIDADE BAIXA — não integrado ao jogo\n← → move a câmera   ·   ENTER liga/desliga o pan automático"
	label.position = Vector2(16.0, 12.0)
	label.add_theme_font_size_override("font_size", 14)
	label.add_theme_color_override("font_color", Color(0.75, 0.85, 0.9, 0.85))
	label.add_theme_color_override("font_outline_color", Color(0.0, 0.0, 0.0, 0.9))
	label.add_theme_constant_override("outline_size", 4)
	layer.add_child(label)


func _update_camera(delta: float) -> void:
	var manual := Input.get_axis("ui_left", "ui_right")
	if not is_zero_approx(manual):
		auto_pan = false
		_camera.position.x += manual * pan_speed * 4.0 * delta
	elif auto_pan:
		_camera.position.x += _pan_direction * pan_speed * delta
		if _camera.position.x > WORLD_W - 640.0 or _camera.position.x < 640.0:
			_pan_direction = -_pan_direction
	_camera.position.x = clampf(_camera.position.x, 640.0, WORLD_W - 640.0)
	# Reference actors: 4 fps idle, same cadence as the game.
	var frame := int(_clock * 4.0) % 4
	for child in get_children():
		if child is Sprite2D and child.has_meta("animated"):
			(child as Sprite2D).frame = frame


func _update_lights(delta: float) -> void:
	# Neon: steady glow with a rare, short brown-out; never a strobe.
	_flicker_at -= delta
	if _flicker_at <= 0.0:
		_flicker_left = 0.22
		_flicker_at = randf_range(4.0, 9.0)
	var level := 1.0
	if _flicker_left > 0.0:
		_flicker_left -= delta
		level = 0.35 if int(_flicker_left * 40.0) % 2 == 0 else 0.85
	_signs.modulate.a = level
	_sign_glow.modulate.a = level * (0.85 + 0.15 * sin(_clock * 1.7))
	_puddles.modulate.a = 0.75 + 0.25 * sin(_clock * 2.3)
	_lamp.modulate.a = 0.92 + 0.08 * sin(_clock * 11.0) * sin(_clock * 0.7)
