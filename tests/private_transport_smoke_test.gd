extends SceneTree
## Requires loopback TLS fixture generated by private_relay_test.py; no real credentials.
const CLIENT := preload("res://scene/network/private_session_client.gd")
const DOCUMENT := preload("res://scene/persistence/atomic_document.gd")
var got_input := false
var failures := 0


func _initialize() -> void:
	call_deferred("_run")


func check(condition: bool, message: String) -> void:
	if not condition:
		failures += 1
		push_error(message)


func _run() -> void:
	var args: PackedStringArray = OS.get_cmdline_user_args()
	if args.size() != 1:
		quit(2)
		return
	var fixture: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(args[0]))
	var certificate: X509Certificate = X509Certificate.new()
	check(certificate.load(fixture.cert) == OK, "load local test certificate")
	var client: PrivateSessionClient = CLIENT.new()
	client.backup_root = fixture.backup_root
	root.add_child(client)
	client.input_received.connect(func(peer: int, sequence: int, actions: Dictionary) -> void: got_input = peer == 2 and sequence == 1 and actions.get("right", false))
	check(client.connect_session(fixture.url, "create", fixture.token, "", "d".repeat(32), TLSOptions.client(certificate)) == OK, "WSS connect initiated")
	var deadline: int = Time.get_ticks_msec() + 20000
	while client.status == "connecting" and Time.get_ticks_msec() < deadline:
		await process_frame
	check(client.peer_id == 1 and client.invitations.size() == 3, "server authorizes and issues three invites")
	if client.peer_id != 1:
		client.leave()
		client.free()
		quit(1)
		return
	var output: FileAccess = FileAccess.open(fixture.output, FileAccess.WRITE)
	output.store_string(JSON.stringify({"room_id": client.room_id, "invites": client.invitations}))
	output.close()
	while client.lobby.get("connected", []).size() < 4 and Time.get_ticks_msec() < deadline:
		await process_frame
	check(client.start_session() == OK, "four-seat start requested")
	while client.status != "active" and Time.get_ticks_msec() < deadline:
		await process_frame
	check(client.status == "active", "protocol active")
	check(client.publish_snapshot({"world_state": {"fixture": true}, "player_states": {}, "story_state": {}, "inventory_state": {}}) == OK, "host publishes protocol snapshot")
	while (not got_input or client.revision < 1) and Time.get_ticks_msec() < deadline:
		await process_frame
	check(got_input, "guest input delivered to Godot host with server-assigned peer")
	var backup: AtomicDocument = DOCUMENT.new()
	backup.directory = client.backup_root.path_join(client.room_id)
	var data: Dictionary = backup.read()
	check(data.get("session_id", "") == client.room_id and int(data.get("revision", 0)) == 1, "only received snapshot persisted separately")
	client.leave()
	client.free()
	print("PRIVATE_TRANSPORT_REPORT failures=", failures)
	quit(0 if failures == 0 else 1)
